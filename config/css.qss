QPushButton {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1,
                stop:0 #55a0ff, stop:1 #55b4ff);
    border-radius: 6px; padding: 4px 12px; color: white; font-weight: bold;
}
QPushButton:hover { background: #55afff; }
QPushButton:pressed { background: #5582ff; }
QPushButton:disabled { background: #cccccc; color: #888888; }
QGroupBox {
    font-weight: bold; border: 1px solid #b0b0b0;
    border-radius: 4px; margin-top: 8px; padding-top: 8px;
}
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 4px; }
QTabWidget::pane { border: 1px solid #b0b0b0; }